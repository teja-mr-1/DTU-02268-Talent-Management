# Max open applications per position before an alert fires
THRESHOLD=8
# Applications generated per second
GEN_RATE=2
# How long a case takes (total) before it closes
WORKER_MIN_SECONDS=2
WORKER_MAX_SECONDS=15

# --- DCR ---
# mock = no account needed (fake 3-step case). real = call repository.dcrgraphs.net
DCR_MODE=mock
# Only needed for DCR_MODE=real
DCR_USERNAME=
DCR_PASSWORD=
# Graph used for every position...
DCR_GRAPH_ID=
# ...optionally overridden per position, e.g. DCR_GRAPH_IDS=engineer=123,sales=456
DCR_GRAPH_IDS=

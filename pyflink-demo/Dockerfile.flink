FROM flink:1.20.0

USER root
RUN apt-get update -y \
 && apt-get install -y --no-install-recommends python3 python3-pip python3-dev build-essential curl \
 && ln -sf /usr/bin/python3 /usr/bin/python \
 && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir apache-flink==1.20.0 requests

# Kafka connector goes on Flink's classpath, so the job doesn't need add_jars
RUN curl -fsSL -o /opt/flink/lib/flink-sql-connector-kafka-3.3.0-1.20.jar \
    https://repo1.maven.org/maven2/org/apache/flink/flink-sql-connector-kafka/3.3.0-1.20/flink-sql-connector-kafka-3.3.0-1.20.jar \
 && chown flink:flink /opt/flink/lib/flink-sql-connector-kafka-3.3.0-1.20.jar

COPY --chown=flink:flink job.py dcr_client.py routing.py /opt/app/
USER flink
